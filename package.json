{
  "name": "gamedev-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:config && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:config": "node scripts/check-config.mjs",
    "preview:offline": "node scripts/preview.mjs",
    "test": "node --test scripts/catalog.test.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5"
  }
}
